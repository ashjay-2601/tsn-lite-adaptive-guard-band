// gcl_ctrl.v -- IEEE 802.1Qbv Gate Control List sequencer
//
// Cyclically walks a programmable list of {gate_mask, interval_ns} entries,
// phase-aligned to a programmable base time on the PTP clock.
//
// Exports remaining_ns: nanoseconds left in the currently open window.  This
// is the signal the adaptive guard band consumes -- in a textbook Qbv
// implementation it does not exist, because the guard band is a constant.
//
// Rollover:  cycle_time = sum(interval[0..len-1]).  The window end time is
// carried in absolute 48-bit ns so there is no wrap hazard for ~78 hours.
// ============================================================================
`default_nettype none

module gcl_ctrl #(
    parameter integer N_ENTRY = 16,
    parameter integer IDX_W   = 4
) (
    input  wire                     clk,
    input  wire                     rst_n,

    input  wire                     enable,
    input  wire [47:0]              time_ns,

    // GCL storage, flattened (Verilog-2001 has no array ports)
    input  wire [N_ENTRY*8-1:0]     gcl_mask_flat,
    input  wire [N_ENTRY*32-1:0]    gcl_ival_flat,
    input  wire [IDX_W:0]           gcl_len,
    input  wire [47:0]              base_time_ns,
    input  wire                     cfg_apply,      // pulse: restart at base_time

    output reg  [7:0]               gate_open,
    output reg  [31:0]              remaining_ns,   // saturating
    output reg  [IDX_W-1:0]         entry_idx,
    output reg                      running
);

    reg  [47:0] win_end_ns;
    wire [IDX_W-1:0] nxt_idx = (entry_idx + 1'b1 >= gcl_len[IDX_W-1:0]) ?
                               {IDX_W{1'b0}} : entry_idx + 1'b1;

    // flattened-array readback
    wire [7:0]  cur_mask  = gcl_mask_flat[entry_idx*8  +: 8];
    wire [7:0]  nxt_mask  = gcl_mask_flat[nxt_idx*8    +: 8];
    wire [31:0] nxt_ival  = gcl_ival_flat[nxt_idx*32   +: 32];

    wire        expired   = running && (time_ns >= win_end_ns);
    wire [47:0] delta     = win_end_ns - time_ns;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            running      <= 1'b0;
            entry_idx    <= {IDX_W{1'b0}};
            win_end_ns   <= 48'd0;
            gate_open    <= 8'h00;
            remaining_ns <= 32'd0;
        end else if (cfg_apply) begin
            running      <= 1'b0;
            entry_idx    <= {IDX_W{1'b0}};
            win_end_ns   <= base_time_ns;
            gate_open    <= 8'h00;
            remaining_ns <= 32'd0;
        end else if (!enable) begin
            running      <= 1'b0;
            gate_open    <= 8'h00;
            remaining_ns <= 32'd0;
        end else if (!running) begin
            // wait for base time, then arm entry 0
            if (time_ns >= win_end_ns) begin
                running    <= 1'b1;
                entry_idx  <= {IDX_W{1'b0}};
                win_end_ns <= win_end_ns + {16'd0, gcl_ival_flat[0 +: 32]};
                gate_open  <= gcl_mask_flat[0 +: 8];
            end
        end else if (expired) begin
            entry_idx    <= nxt_idx;
            win_end_ns   <= win_end_ns + {16'd0, nxt_ival};
            gate_open    <= nxt_mask;
            remaining_ns <= nxt_ival;
        end else begin
            gate_open    <= cur_mask;
            remaining_ns <= (delta > 48'hFFFF_FFFF) ? 32'hFFFF_FFFF : delta[31:0];
        end
    end

endmodule

`default_nettype wire
